{
  "title": {
    "en": "Set heating coil neutral zone"
  },
  "titleFormatted": {
    "en": "Set [[mode]] heating coil neutral zone to [[kelvin]] K"
  },
  "hint": {
    "en": "The electric heating coil only heats when the supply air is this far below the supply air setpoint."
  },
  "args": [
    {
      "type": "device",
