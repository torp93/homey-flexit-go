      "title": {
        "en": "Mode"
      },
      "values": [
        {
          "id": "home",
          "label": {
            "en": "Home"
          }
        },
        {
          "id": "away",
          "label": {
            "en": "Away"
          }
        }
      ]
    },
    {
      "name": "kelvin",
      "type": "number",
