{
  "title": {
    "en": "Set supply air setpoint for a mode"
  },
  "titleFormatted": {
    "en": "Set [[mode]] supply air setpoint to [[temperature]] °C"
  },
  "hint": {
    "en": "Updates the saved supply air setpoint for Home or Away on the unit."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=nordic|nordic-cloud"
    },
    {
      "name": "mode",
      "type": "dropdown",
      "title": {
        "en": "Mode"
      },
      "values": [
        {
          "id": "home",
          "label": {
            "en": "Home"
          }
        },
        {
          "id": "away",
          "label": {
            "en": "Away"
          }
        }
      ]
    },
    {
      "name": "temperature",
      "type": "number",
      "title": {
        "en": "Temperature"
      },
      "min": 10,
      "max": 30,
      "step": 0.5
    }
  ]
}
