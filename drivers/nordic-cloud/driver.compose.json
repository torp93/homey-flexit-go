          "hint": {
            "en": "Exhaust fan speed while de-icing runs."
          },
          "units": {
            "en": "%"
          },
          "value": 75,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "id": "deicing_rotor_start_temperature",
          "type": "label",
          "label": {
            "en": "Rotor reduction below exhaust air temperature"
          },
          "hint": {
            "en": "The rotor is slowed down when the exhaust air is colder than this. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_fan_start_temperature",
          "type": "label",
          "label": {
            "en": "Fan reduction below exhaust air temperature"
          },
          "hint": {
            "en": "The fans are adjusted when the exhaust air is colder than this. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_active_time",
          "type": "label",
          "label": {
            "en": "De-icing duration"
          },
          "hint": {
            "en": "How long each de-icing cycle runs. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_max_off_time",
          "type": "label",
          "label": {
            "en": "Longest pause between cycles"
          },
          "hint": {
            "en": "Pause between de-icing cycles at milder outdoor temperatures. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_off_time_ramp_start_temperature",
          "type": "label",
          "label": {
            "en": "Pause starts shortening at outdoor temperature"
          },
          "hint": {
            "en": "Below this outdoor temperature the pause between cycles gets shorter. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_min_off_time",
          "type": "label",
          "label": {
            "en": "Shortest pause between cycles"
          },
          "hint": {
            "en": "Pause between de-icing cycles at the coldest outdoor temperatures. Read-only, configured on the unit."
          },
          "value": "-"
        },
        {
          "id": "deicing_off_time_ramp_end_temperature",
          "type": "label",
          "label": {
            "en": "Shortest pause from outdoor temperature"
          },
          "hint": {
            "en": "At and below this outdoor temperature the shortest pause is used. Read-only, configured on the unit."
          },
          "value": "-"
        }
      ]
    },
